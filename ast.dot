digraph AST {
  rankdir=TB;
  node [fontname="Arial", fontsize=14, fontcolor="#333333"];
  edge [fontname="Arial", fontsize=10, color="#666666"];
  bgcolor="white";
  
  // AST Simplificada (Abstract Syntax Tree)
  
  node0 [label="void", shape=box, style="filled", fillcolor=lightblue];
  node1 [label="Function\nmain", shape=ellipse, style="filled", fillcolor=gold];
  node0 -> node1 [weight=10];
  node2 [label="{}", shape=box, style="filled", fillcolor=lightcoral];
  node1 -> node2 [weight=10];
  node3 [label="int", shape=box, style="filled", fillcolor=lightblue];
  node2 -> node3 [weight=10];
  node4 [label="Var\nx", shape=box, style="filled", fillcolor=lightgreen];
  node3 -> node4 [weight=10];
  node5 [label="=", shape=circle, style="filled", fillcolor=khaki];
  node6 [label="output()", shape=box, style="filled", fillcolor=peachpuff];
  node2 -> node5 [weight=10];
  node2 -> node6 [style=invis, weight=10];
  { rank=same; node5; node6; }
  node5 -> node6 [style=dashed, color=gray, constraint=false, minlen=2];
  node7 [label="x", shape=box, style="filled", fillcolor=lightyellow];
  node5 -> node7 [weight=10];
  node8 [label="42", shape=circle, style="filled", fillcolor=lightpink];
  node5 -> node8 [weight=10];
  node9 [label="x", shape=box, style="filled", fillcolor=lightyellow];
  node6 -> node9 [weight=10];
}
